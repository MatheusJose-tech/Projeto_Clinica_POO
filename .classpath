<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER"/>
	<classpathentry excluding="facade/|repository/|view/|controller/" kind="src" path="src"/>
	<classpathentry kind="src" path="src/controller"/>
	<classpathentry kind="src" path="src/facade"/>
	<classpathentry kind="src" path="src/repository"/>
	<classpathentry kind="src" path="src/view"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
